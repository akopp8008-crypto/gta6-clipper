# YouTube Data API key (research) - Google Cloud console, enable "YouTube Data API v3"
YOUTUBE_API_KEY=
# YouTube upload (OAuth client + refresh token for your channel)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# TikTok Content Posting API (developer app). Set TIKTOK_AUDITED=1 after the audit passes.
TIKTOK_ACCESS_TOKEN=
TIKTOK_AUDITED=0
# Instagram Graph API (Business/Creator account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
CLIP_PUBLIC_BASE_URL=
# Optional AI ranking (--ai)
ANTHROPIC_API_KEY=
